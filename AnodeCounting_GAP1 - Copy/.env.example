# ----------------------------
# Model
# ----------------------------
MODEL_PATH=best.pt
CONF_THRES=0.35
IOU_THRES=0.5

# ----------------------------
# Camera
# ----------------------------
CAMERA_NAME=GAP1_BakeOven_AnodeHandover
RTSP_URL=rtsp://<username>:<password>@<camera_ip>:554/Streaming/Channels/101

VIDEO_PATH=Video1.mp4
# ----------------------------
# Counting line (RED)
# ----------------------------
LINE_Y=520
LINE_X1=0
LINE_X2=1920
COUNT_DIRECTION=up   # down = above->below, up = below->above

# ----------------------------
# RTSP / OpenCV low latency
# ----------------------------
RTSP_TRANSPORT=tcp     # tcp recommended if stream drops; udp can be lower latency 
OPENCV_BUFFERSIZE=1

# ----------------------------
# Track cleanup
# ----------------------------
TRACK_STALE_FRAMES=60

# ----------------------------
# SQL Server
# ----------------------------
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=<sql_server_ip>
SQL_DB=AnodeCounting_VideoAnalyticsV1
SQL_USER=<username>
SQL_PASS=<password>
SQL_TRUSTED=false

# ----------------------------
# FastAPI
# ----------------------------
API_HOST=0.0.0.0
API_PORT=8000
