# Comments must be on their own line: some loaders do not strip "# ..." after a value.

# ----------------------------
# Model
# ----------------------------
MODEL_PATH=best.pt
# Minimum detector confidence passed to the tracker. ByteTrack relies on
# low-confidence detections to keep following a hole through fumes, so keep
# this low (Ultralytics' tracking default is 0.10). The old value was 0.35.
CONF_THRES=0.10
IOU_THRES=0.5
# Counting evidence:
#   track (default): a hole counts when its track crosses the line and has at
#     least COUNT_MIN_HITS detections >= COUNT_MIN_CONF at any time. Crossings
#     without that evidence are stored as rejected crossings, not counted.
#   frame (legacy): only detections >= COUNT_MIN_CONF are used at all, so a
#     hole whose confidence dips while crossing is missed.
COUNT_EVIDENCE=track
COUNT_MIN_CONF=0.80
COUNT_MIN_HITS=2
# CUDA device index (0) or cpu
DEVICE=0

# ----------------------------
# Camera / video source
# ----------------------------
CAMERA_NAME=GAP1_BakeOven_AnodeHandover
# rtsp (live camera) or file (replay VIDEO_PATH; for testing only)
SOURCE=rtsp
RTSP_URL=rtsp://<username>:<password>@<camera_ip>:554/Streaming/Channels/101
VIDEO_PATH=Video1.mp4

# ----------------------------
# Counting line (RED)
# ----------------------------
LINE_Y=520
# In track evidence mode only crossings between LINE_X1 and LINE_X2 count;
# narrow this to the hole lane to ignore detections elsewhere in the picture.
LINE_X1=0
LINE_X2=1920
# Required. up = objects move from bottom to top of the image, down = top to bottom.
# In the GAP1 camera view anodes move away from the camera, i.e. up.
COUNT_DIRECTION=up
HOLES_PER_ANODE=4

# ----------------------------
# Anode grouping
# ----------------------------
# modulo:     legacy - every HOLES_PER_ANODE-th counted hole is one anode. A start
#             mid-anode or one missed hole shifts every later anode record.
# structural: holes are grouped by their position on the belt (grouping.py);
#             every anode record says how many of its holes were seen
#             (CONFIRMED / PARTIAL / UNCERTAIN).
# The method not selected runs alongside and is stored in
# dbo.AnodeGroupingShadow for comparison. Keep modulo until the comparison on
# real production footage supports switching.
ANODE_GROUPING=modulo
# Empty hole positions between consecutive anodes on the belt (GAP1: 1)
ANODE_GAP_SLOTS=1
# Image distance (px) from a hole on the counting line to the hole 1 and 2
# pitches ahead. Calibrate with: python replay.py --video <production clip> ...
# and copy "structural_spacing_px" from the summary. Learned automatically if
# unset (anode records are then held until ~8 holes have crossed).
# Video1.mp4 (1280x720 export): 64.9 / 108.5
HOLE_SPACING_PX=
HOLE_SPACING_2_PX=
# Holes within this horizontal distance (px) of each other are in the same lane
LANE_HALF_WIDTH_PX=80

# ----------------------------
# Visibility (fumes)
# ----------------------------
# Contrast is measured in a band of +/- VISIBILITY_BAND_PX around LINE_Y. When it
# falls below VISIBILITY_LOW_RATIO of the clear-view baseline AND no hole is
# detected confidently for VISIBILITY_MIN_DURATION_S, the period is recorded in
# dbo.CountingGaps as LOW_VISIBILITY (anodes passing then could not be observed).
VISIBILITY_BAND_PX=120
VISIBILITY_LOW_RATIO=0.5
VISIBILITY_MIN_DURATION_S=2
# Clear-view contrast at the counting line. 41 was measured on Video1.mp4 from
# the GAP1 camera (90th percentile over all frames; single frames 35-42).
# Re-check once with a replay of a clip recorded from the live stream and use
# its "visibility_contrast.p90"; repeat if the camera is moved or re-aimed.
# If left empty, it is learned at startup as a rolling 90th percentile, which
# is wrong if the service starts while fumes cover the line.
VISIBILITY_BASELINE=41
VISIBILITY_WINDOW_S=7200

# ----------------------------
# RTSP
# ----------------------------
# tcp recommended if stream drops; udp can be lower latency
RTSP_TRANSPORT=tcp
# Note: OPENCV_BUFFERSIZE is no longer used. OpenCV's FFmpeg backend ignores
# CAP_PROP_BUFFERSIZE, so the setting never had an effect.
RTSP_OPEN_TIMEOUT_MS=10000
# A stalled stream is detected after this long (OpenCV default was 30 s)
RTSP_READ_TIMEOUT_MS=5000
# Reconnect waits 1 s, then doubles up to this maximum
RECONNECT_MAX_S=30
# Frames buffered between capture and counting. Absorbs short hiccups and
# bounds how far counting can fall behind the belt (10 frames = 0.5 s at 20 fps).
CAPTURE_BUFFER_FRAMES=10
# Longest acceptable interval between processed frames. Longer intervals are
# recorded in dbo.CountingGaps because holes could pass unobserved.
# 300 ms was derived from Video1.mp4 belt speed; re-check at maximum belt speed.
MAX_FRAME_GAP_MS=300

# ----------------------------
# Track cleanup
# ----------------------------
TRACK_STALE_FRAMES=60

# ----------------------------
# SQL Server
# ----------------------------
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=<sql_server_ip>
SQL_DB=AnodeCounting_VideoAnalyticsV1
SQL_USER=<username>
SQL_PASS=<password>
SQL_TRUSTED=false

# ----------------------------
# Local event outbox
# ----------------------------
# Every event is stored here first and delivered to SQL Server in the
# background, so a database outage never stops counting or loses events.
# Keep it on a local disk that is backed up with the server.
OUTBOX_PATH=data/outbox.sqlite3
# Delivered events are kept locally this many days (for re-sending/audit)
OUTBOX_RETENTION_DAYS=30

# ----------------------------
# FastAPI / health
# ----------------------------
# The service has no authentication: restrict access to port API_PORT with the
# server firewall (dashboard host and operators only).
API_HOST=0.0.0.0
API_PORT=8000
# Live preview (/mjpeg) is encoded only while someone is watching
PREVIEW_MAX_FPS=5
PREVIEW_WIDTH=960
PREVIEW_JPEG_QUALITY=70
# /health returns 503 when no frame was processed for this many seconds
HEALTH_MAX_FRAME_AGE_S=10
# Allowed time for model loading and first camera connection after start
STARTUP_GRACE_S=120
