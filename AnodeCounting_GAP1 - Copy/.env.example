# Comments must be on their own line: some loaders do not strip "# ..." after a value.

# ----------------------------
# Model
# ----------------------------
MODEL_PATH=best.pt
# Minimum detector confidence passed to the tracker
CONF_THRES=0.35
IOU_THRES=0.5
# Minimum confidence for a detection to be used for counting
COUNT_MIN_CONF=0.80
# CUDA device index (0) or cpu
DEVICE=0

# ----------------------------
# Camera / video source
# ----------------------------
CAMERA_NAME=GAP1_BakeOven_AnodeHandover
# rtsp (live camera) or file (replay VIDEO_PATH; for testing only)
SOURCE=rtsp
RTSP_URL=rtsp://<username>:<password>@<camera_ip>:554/Streaming/Channels/101
VIDEO_PATH=Video1.mp4

# ----------------------------
# Counting line (RED)
# ----------------------------
LINE_Y=520
LINE_X1=0
LINE_X2=1920
# Required. up = objects move from bottom to top of the image, down = top to bottom.
# In the GAP1 camera view anodes move away from the camera, i.e. up.
COUNT_DIRECTION=up
HOLES_PER_ANODE=4

# ----------------------------
# RTSP
# ----------------------------
# tcp recommended if stream drops; udp can be lower latency
RTSP_TRANSPORT=tcp
# Note: OPENCV_BUFFERSIZE is no longer used. OpenCV's FFmpeg backend ignores
# CAP_PROP_BUFFERSIZE, so the setting never had an effect.
RTSP_OPEN_TIMEOUT_MS=10000
# A stalled stream is detected after this long (OpenCV default was 30 s)
RTSP_READ_TIMEOUT_MS=5000
# Reconnect waits 1 s, then doubles up to this maximum
RECONNECT_MAX_S=30
# Frames buffered between capture and counting. Absorbs short hiccups and
# bounds how far counting can fall behind the belt (10 frames = 0.5 s at 20 fps).
CAPTURE_BUFFER_FRAMES=10
# Longest acceptable interval between processed frames. Longer intervals are
# recorded in dbo.CountingGaps because holes could pass unobserved.
# 300 ms was derived from Video1.mp4 belt speed; re-check at maximum belt speed.
MAX_FRAME_GAP_MS=300

# ----------------------------
# Track cleanup
# ----------------------------
TRACK_STALE_FRAMES=60

# ----------------------------
# SQL Server
# ----------------------------
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=<sql_server_ip>
SQL_DB=AnodeCounting_VideoAnalyticsV1
SQL_USER=<username>
SQL_PASS=<password>
SQL_TRUSTED=false

# ----------------------------
# Local event outbox
# ----------------------------
# Every event is stored here first and delivered to SQL Server in the
# background, so a database outage never stops counting or loses events.
# Keep it on a local disk that is backed up with the server.
OUTBOX_PATH=data/outbox.sqlite3
# Delivered events are kept locally this many days (for re-sending/audit)
OUTBOX_RETENTION_DAYS=30

# ----------------------------
# FastAPI / health
# ----------------------------
API_HOST=0.0.0.0
API_PORT=8000
# /health returns 503 when no frame was processed for this many seconds
HEALTH_MAX_FRAME_AGE_S=10
# Allowed time for model loading and first camera connection after start
STARTUP_GRACE_S=120
